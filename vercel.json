{
  "version": 2,
  "buildCommand": "PORT=5173 BASE_PATH=/ pnpm --filter @workspace/nexus-fleet build",
  "outputDirectory": "artifacts/nexus-fleet/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://nexus-fleet-backend.onrender.com/api/$1"
    },
    {
      "source": "/ws/(.*)",
      "destination": "wss://nexus-fleet-backend.onrender.com/ws/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
