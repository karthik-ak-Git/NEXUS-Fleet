{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/nexus-fleet/package.json",
      "use": "@vercel/vite"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "http://localhost:8000/api/$1"
    },
    {
      "src": "/ws/(.*)",
      "dest": "ws://localhost:8000/ws/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/artifacts/nexus-fleet/index.html"
    }
  ]
}
