{
  "name": "nexus-fleet",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev:backend": "uv run uvicorn backend.app.main:app --host 0.0.0.0 --port 8000",
    "dev:frontend": "pnpm --filter @workspace/nexus-fleet dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "test:backend": "uv run pytest backend/tests",
    "typecheck": "pnpm -r --filter \"./artifacts/**\" --if-present run typecheck"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
